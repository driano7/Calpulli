# ─── Noticias automáticas (cron mensual) ───
# NewsAPI.org: para obtener artículos de turismo de México
NEWS_API_KEY=

# IA Assistant (elige 1): OpenRouter ~50/día free, Groq ~14k/día free, Gemini 1000/día (tú, 1M tokens)
# Config actual: Gemini (PROJECT 630419527077) → GEMINI_API_KEY
AI_PROVIDER=gemini
OPENROUTER_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# La MISMA GROQ_API_KEY alimenta el dictado por voz del chat (Ocelote AI):
# POST /api/transcribe usa Groq Whisper. Sin llave, el endpoint responde
# 503 y el chat cae solo al dictado del navegador (donde exista).
GROQ_WHISPER_MODEL=whisper-large-v3
GEMINI_API_KEY=
GEMINI_KEY=
GEMINI_MODEL=gemini-1.5-flash
PROJECT=projects/630419527077
NUMBER_PROJECT=630419527077
# Limites Calpulli (1000/día, 50/min, burst 120/15min anti-hack)
AI_DAILY_LIMIT=1000
AI_PER_MINUTE_LIMIT=50
AI_BURST_LIMIT=120
# OpenRouter: genera las 3 notas del mes (modelo free)
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ─── Turso (única base de datos: notas, auth, reservas, analytics, socios) ───
# Esquema canónico: turso-schema.sql
TURSO_URL=
TURSO_API_KEY=
# Nombres alternativos aceptados por el cliente (equivalentes):
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# ─── FRED (macros económicos, opcional / best-effort) ───
FRED=
# o
FRED_API_KEY=

# ─── Sitio ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Stripe (checkout con tarjeta, modo prueba) ───
# Solo se aceptan claves de prueba (sk_test_...)
STRIPE_SECRET_KEY=sk_test_...
# Opcional: webhook de Stripe para confirmar checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Roles (paneles admin/empleados, patrón Criptec) ───
# Separados por coma. Efecto inmediato sin tocar BD.
# Fallback persistente: tabla user_roles (ver turso-schema.sql)
ADMIN_EMAILS=admin@amaxing.mx,donovan@amaxing.mx
EMPLOYEE_EMAILS=guia1@amaxing.mx,operaciones@amaxing.mx

# ─── Comentarios (giscus / utterances / disqus) ───
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
NEXT_PUBLIC_UTTERANCES_REPO=
NEXT_PUBLIC_DISQUS_SHORTNAME=

# ---- Crypto payments (Xoco-POS style) ----
# Wallet EVM del negocio (Ethereum/Base). Mismo address para ambas redes.
NEXT_PUBLIC_CRYPTO_WALLET_EVM=0x0000000000000000000000000000000000000000
# Lightning address (LNURL / email-style)
NEXT_PUBLIC_CRYPTO_WALLET_LIGHTNING=amaxing@walletofsatoshi.com
# MAINNET o TESTNET
NEXT_PUBLIC_CHAIN_MODE=TESTNET
# Exploradores (2026-11): Ethereum y Arbitrum usan Etherscan API V2 con UNA
# sola key (gratis en etherscan.io/apis). Base y Optimism van por Blockscout
# público, sin key: no se necesita ninguna otra variable.
NEXT_PUBLIC_ETHERSCAN_API_KEY=   # Ya NO hace falta: la vigilancia del pago va por el servidor (/api/bookings/crypto/status) y la llave nunca se expone en el navegador
# Wallet Bitcoin on-chain. SIN fallback: si está vacía, la red no se ofrece.
NEXT_PUBLIC_CRYPTO_WALLET_BTC=
# Permitir pagos mock (solo para pruebas; nunca en MAINNET)
CRYPTO_ALLOW_MOCK=false
# Lightning: la verificación es LNURL/LUD-21 contra la wallet; sin API key.
# (NEXT_PUBLIC_LN_API_URL_* quedó como respaldo legado, ya no se usa.)

# ─── Brevo (correo transaccional) ───
# Configurar en https://brevo.com y copiar la clave API SMTP/transaccional.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Calpulli CDMX

# Proveedor de correo: 'brevo' | 'smtp' | 'mailgun'
MAIL_PROVIDER=brevo
# Interruptor maestro: 'true' para permitir envíos reales; cualquier otro valor
# deja el servicio en modo skip (solo registra en email_log).
MAIL_ENABLED=true

# ─── Reportes de socios y equipo ───
# Los destinatarios salen de ADMIN_EMAILS / EMPLOYEE_EMAILS y user_roles.
# El cron diario envía el reporte diario; lunes el semanal y día 1 el mensual.
REPORTS_ENABLED=true
# Opcional: si se define, Vercel debe mandar Authorization: Bearer <secreto>.
CRON_SECRET=

# ─── Bruno (Piso 2: eventos de la app hacia Bruno) ───
# URL del receptor (Cloudflare Worker) que guarda los eventos de reservas
# y socios en un archivo privado. Ver tools/bruno-receiver/README.md.
# Sin estas dos variables, la app no envía nada (y funciona igual).
BRUNO_WEBHOOK_URL=
# Secreto compartido con el receptor: firma HMAC-SHA256 de cada evento.
# Debe ser exactamente el mismo en la app y en el Worker.
BRUNO_WEBHOOK_SECRET=
